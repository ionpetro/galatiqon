[Unit]
Description=Galatiqon - live Pi health dashboard (http://<host>:8080/, JSON + SSE for the web app)
After=network-online.target
Wants=network-online.target

[Service]
# pi is in the video group (vcgencmd needs /dev/vchiq) and adm (journal and kernel log)
User=pi
Group=pi
SupplementaryGroups=video adm
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/galatiqon/dashboard.py --host 0.0.0.0 --port 8080
Nice=10
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
