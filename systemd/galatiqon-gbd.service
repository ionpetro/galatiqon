[Unit]
Description=Galatiqon - Grok Bot daemon (gbd, local API on a Unix socket)
After=network-online.target
Wants=network-online.target

[Service]
User=galatiqon
Group=galatiqon
Environment=HOME=/home/galatiqon
ExecStart=/usr/local/bin/gb daemon run
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
